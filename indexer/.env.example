DATABASE_URL=postgres://user:password@localhost:5432/flowroute
DATABASE_SSL=0
# INDEXER_START_LEDGER is only a bootstrap hint for a fresh database (empty cursor table). The public RPC only
# retains a rolling window of ledgers; if this value is older than that window, the worker logs a warning and
# bootstraps from the RPC's current retained floor instead. Events older than that floor are unavailable from this
# RPC endpoint and are not recovered -- 0 is a safe default precisely because it always falls back to the floor.
INDEXER_START_LEDGER=0
